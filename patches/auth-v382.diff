+    """worker_registry.user_id·app_installed 배선. 실패해도 로그인을 막지 않는다.
+
+    v3.8.2: 견고화 + 관측성 보강.
+      v3.8.0 에서 이 배선이 동작하지 않아 수동 SQL 로 처리해야 했다. 컬럼 타입·
+      제약을 실측했으나 결함을 특정하지 못했고, 예외 로그도 남지 않아 어느 단계에서
+      빠졌는지 알 수 없었다. 그래서 (1) 정확 일치가 실패하면 정규화 대조로 폴백하고
+      (2) 각 분기에서 결과를 남기며 (3) 갱신 후 실제 반영을 확인한다.
+    """
+    clean = normalize_phone(phone)
+    target = None
+
+    # 1차 — 저장 형식이 무엇이든 맞도록 양쪽 형식으로 정확 일치를 시도한다.
+    for v in _phone_variants(phone):
+        try:
+            r = supabase.table("worker_registry").select("id,user_id,phone").eq("phone", v).limit(1).execute()
+            if r.data:
+                target = r.data[0]
+                break
+        except Exception as e:
+            log.error(f"[verify-otp] worker_registry 조회 실패 phone={v}: {e}")
+
+    # 2차 — 저장값에 공백·국가번호 등 예상 외 표기가 섞여 있을 수 있다.
+    # 후보를 받아 숫자만 남겨 대조한다. 등록 인원이 많지 않은 구간이라 비용이 작다.
+    if not target and clean:
+        try:
+            tail = clean[-8:]
+            r = supabase.table("worker_registry").select("id,user_id,phone").ilike("phone", f"%{tail}%").limit(20).execute()
+            for row in (r.data or []):
+                if normalize_phone(row.get("phone") or "") == clean:
+                    target = row
+                    break
+        except Exception as e:
+            log.error(f"[verify-otp] worker_registry 폴백 조회 실패 phone={clean}: {e}")
+
+    if not target:
+        # 등록되지 않은 번호로는 여기까지 오지 않는다(_ensure_user_row 가 먼저 막는다).
