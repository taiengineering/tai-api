# TAI API 환경 변수 예시
# 사용법:
#   cp .env.example .env
#   vi .env   # 실제 값 입력
#   set -a; source .env; set +a

# ============================================================
# Supabase (필수)
# ============================================================
# https://supabase.com/dashboard/project/xntdkrjhgcscmqctdzyo/settings/api

SUPABASE_URL=https://xntdkrjhgcscmqctdzyo.supabase.co
SUPABASE_KEY=eyJxxx...                     # anon 키 (일반 요청)
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...        # service role (RLS 우회, 서버 전용)

# ============================================================
# Internal API (필수 - uvicorn 기동 시)
# ============================================================
# Railway/프로덕션 secrets에서 가져오거나 로컬에서는 임의의 문자열
INTERNAL_API_SECRET=local-dev-secret

# ============================================================
# 메일 (Resend, 자동 발송 전용)
# ============================================================
# Resend는 자동 발송(인증·결제·진단결과 등)에만 사용.
# 외부 메일 수신은 Google Workspace Gmail에서 처리.
RESEND_API_KEY=re_xxx

# 자동 메일에 답장이 가는 주소 (Workspace Gmail 등).
# 미설정 시 reply_to 헤더 미부착 → from 주소로 답장 시도.
# system@... 같은 답장 불가 주소로 발송할 때 특히 권장.
MAIL_DEFAULT_REPLY_TO=admin@taieng.co.kr

# ============================================================
# 법제처 OpenAPI (법령 수집 시만 필요)
# ============================================================
LAW_API_OC=taieng

# ============================================================
# OAuth 간편로그인 (이 키만 입력하면 동작) — routers/oauth.py
# ============================================================
# 네이버 — https://developers.naver.com/apps/#/list
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 — https://developers.kakao.com/console/app
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=                       # 선택: 카카오 앱에서 on 했을 때만 입력

# 구글 — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth 콜백/리다이렉트 URL — 기본값 그대로 쓰면 OK
OAUTH_REDIRECT_BASE=https://api.taieng.co.kr
OAUTH_FRONTEND_SUCCESS_URL=https://taieng.co.kr/log-in.html
OAUTH_FRONTEND_REGISTER_URL=https://taieng.co.kr/sign-up-oauth.html
OAUTH_FRONTEND_ERROR_URL=https://taieng.co.kr/log-in.html?error=oauth

# 각 provider의 관리 콘솔에 등록해야 하는 Callback URL:
#   네이버:  https://api.taieng.co.kr/auth/oauth/naver/callback
#   카카오: https://api.taieng.co.kr/auth/oauth/kakao/callback
#   구글:    https://api.taieng.co.kr/auth/oauth/google/callback

# ============================================================
# 본인인증 (이니시스 통합인증 SA) — routers/inicis_auth.py
# ============================================================
INICIS_SA_MID=INIiasTest
INICIS_SA_API_KEY=TGdxb2l3enJDWFRTbTgvREU3MGYwUT09
INICIS_SA_SEED_IV=SASKGINICIS00000
INICIS_SA_MODE=test
API_BASE_URL=https://api.taieng.co.kr

# (레거시) 간편인증 구 스펙 — identity.py 사용 시
INICIS_VERIFY_MID=
INICIS_VERIFY_SITE_CD=
INICIS_VERIFY_SITE_KEY=

# ============================================================
# Railway 프로젝트 (배포 시)
# ============================================================
# RAILWAY_STATIC_URL=...
# RAILWAY_PUBLIC_DOMAIN=...

# ============================================================
# 선택 사항
# ============================================================
# OPENAI_API_KEY=sk-...                  # AI 기능
# ANTHROPIC_API_KEY=sk-ant-...           # Claude 기능
# SLACK_WEBHOOK_URL=https://hooks...     # 알림

# 고객응대 질문 분류기(services/support_classifier_svc.py)의 LLM 호출 timeout(초).
# 미설정 시 OpenAI SDK 기본 동작을 그대로 사용(코드에 임의 수치를 박지 않음).
# 운영에서 HANDOFF E2E latency 를 측정한 뒤 값을 확정해 주입 권장.
# SUPPORT_CLASSIFIER_TIMEOUT_SECONDS=
